---
import { Kofi } from 'simple-icons-astro'
import ExternalLink from '../components/ExternalLink.astro'
import ProjectCard from '../components/ProjectCard.astro'
import { projects } from '../data/projects'
import Layout from '../layouts/Layout.astro'
---

<Layout title="$ ./nitrrine.sh">
  <section>
    <h1>Hello, world!</h1>
    <p>
      I'm a software engineering student and a reverse engineering hobbyist from
      the Kazakhstan.
    </p>
  </section>
  <section>
    <h2>Experiences</h2>
    <p>Projects and things I've worked on or still working.</p>
    <ul>
      {
        projects.map((project) => (
          <li>
            <ProjectCard
              title={project.title}
              date={project.date}
              description={project.description}
              links={project.links}
            />
          </li>
        ))
      }
    </ul>
  </section>
  <section>
    <h2>Donate</h2>
    <ExternalLink to="https://ko-fi.com/nitrrine"
      ><Kofi size="20" /> Support me via Ko-fi</ExternalLink
    >
  </section>
</Layout>

<style>
  ul {
    list-style: none;
  }

  li {
    margin-left: 0;
  }
</style>
