---
const { title } = Astro.props

import ExternalLink from "../components/ExternalLink.astro"
import "../styles/global.scss"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Hello! I'm a software engineering student and reverse engineering hobbyist."
    />
    <meta
      name="theme-color"
      content="#ea76cb"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#f5bde6"
      media="(prefers-color-scheme: dark)"
    />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <nav>
      <h2>Nitrrine</h2>
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      <div class="left">
        Copyright &copy; {new Date().getFullYear()}
      </div>
      <div class="right">
        <ExternalLink to="https://github.com/Nitrrine/nitrrine.github.io"
          >This website is open source</ExternalLink
        >
      </div>
    </footer>
  </body>
</html>
